# Supabase — leave empty to run in mock mode (the whole app still works)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Suzi's brain. Leave empty and every AI surface falls back to the built-in
# deterministic answers — the product stays fully clickable, just not smart.
# Set it and Suzi's chat, property Q&A, natural-language search and listing
# generation all run on a real model. Server-only: never expose this to the
# browser, and never prefix it with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Optional — overrides the model without a code change. Defaults to
# claude-opus-5.
ZOUZA_AI_MODEL=

# Absolute URL of the deployed app (used for SEO / Open Graph / sitemap)
NEXT_PUBLIC_APP_URL=http://localhost:3000
