# Supabase — leave empty to run in mock mode (the whole app still works)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Suzi's brain. Set ONE of these and every AI surface (chat, property Q&A,
# natural-language search, listing generation) runs on a real model. Leave
# both empty and they fall back to the built-in deterministic answers —
# the product stays fully clickable, just not smart.
#
# Server-only: never expose either to the browser, never prefix with
# NEXT_PUBLIC_.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Which provider to use when both keys are present. Defaults to
# openai. Values: openai | anthropic
ZOUZA_AI_PROVIDER=

# Optional. Overrides the model without a code change. Defaults to
# gpt-5-nano on OpenAI, claude-opus-5 on Anthropic.
ZOUZA_AI_MODEL=

# Absolute URL of the deployed app (used for SEO / Open Graph / sitemap)
NEXT_PUBLIC_APP_URL=http://localhost:3000
