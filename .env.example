# Supabase — leave empty to run in mock mode (the whole app still works)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers — leave empty to use deterministic mock generation
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Absolute URL of the deployed app (used for SEO / Open Graph / sitemap)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public JSON API for the iOS app (/api/v1) — all optional
# Comma-separated browser origins allowed by CORS (Expo web preview only; dev origins are automatic outside production)
API_ALLOWED_ORIGINS=
# Oldest / newest app version served by /api/v1/meta. When a variable is unset
# the route reports 1.0.0. Do not leave these two empty in a real env file (an
# empty value is served as ""): set a version such as 1.0.0, or delete the line.
APP_MIN_VERSION=
APP_LATEST_VERSION=
