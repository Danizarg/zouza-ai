{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Zouza design system v2",
  "version": "2.0.0",
  "updated": "2026-10-16",
  "source": "app/globals.css @theme — keep both files identical hex for hex",
  "color": {
    "brand": {
      "50": "#F4F1FE",
      "100": "#EEEAFE",
      "200": "#DCD4FC",
      "300": "#C1B3F9",
      "400": "#9C86F5",
      "500": "#7255F0",
      "600": "#5E3FE0",
      "700": "#4B2FC4",
      "800": "#3B259C",
      "900": "#2D1F7A",
      "950": "#231760"
    },
    "paper": "#FAF9FC",
    "paper-2": "#F2F0F7",
    "surface": "#FFFFFF",
    "border": "#E6E3EF",
    "border-strong": "#8F8AA6",
    "ink": "#24223A",
    "ink-2": "#3A3850",
    "muted": "#6A6880",
    "muted-2": "#747286",
    "faint": "#9896A8",
    "success": "#2E7D5B",
    "danger": "#B4453D"
  },
  "semantic": {
    "primary": "{color.brand.500}",
    "primary-hover": "{color.brand.600}",
    "on-primary": "#FFFFFF",
    "accent-soft": "{color.brand.100}",
    "dark": "{color.brand.900}",
    "focus": "{color.brand.500}",
    "selection-bg": "{color.brand.100}",
    "selection-fg": "{color.ink}",
    "eyebrow": "{color.muted}",
    "glow": "{color.brand.400}"
  },
  "shadow": {
    "card": "0 1px 2px rgba(36, 34, 58, 0.05), 0 10px 28px -14px rgba(36, 34, 58, 0.14)",
    "lift": "0 2px 4px rgba(36, 34, 58, 0.07), 0 18px 44px -16px rgba(36, 34, 58, 0.24)"
  },
  "font": {
    "display": {
      "family": "Fraunces",
      "weight": 600,
      "fallback": ["Georgia", "Times New Roman", "serif"],
      "use": "h1, h2 and prices only; never italic"
    },
    "sans": {
      "family": "Inter",
      "weights": [400, 500, 600],
      "fallback": ["system-ui", "-apple-system", "sans-serif"],
      "use": "body, UI, card titles, h3"
    }
  },
  "radius": {
    "control": "0.5rem",
    "card": "0.75rem",
    "card-large": "1rem",
    "pill": "9999px"
  },
  "mark": {
    "name": "Z mark B (Voice)",
    "viewBox": "0 0 64 64",
    "strokeWidth": 9,
    "paths": ["M14 14h32", "M50 14 14 50", "M14 50h22"],
    "dot": { "cx": 50, "cy": 50, "r": 5.5 },
    "note": "fill none, stroke currentColor, round caps and joins; the dot is filled with currentColor"
  }
}
